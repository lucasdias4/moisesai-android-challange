<?xml version="1.0" encoding="utf-8"?>
<!-- The musical note of the splash, 60 dp wide inside the 108 dp canvas. The note itself is off the centre of its own
     image, so the insets put the note, not the image, in the middle; it stays inside the 66 dp circle that no launcher
     mask cuts. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_music_note"
    android:insetLeft="26.7dp"
    android:insetTop="25.2dp"
    android:insetRight="21.3dp"
    android:insetBottom="22.8dp" />
