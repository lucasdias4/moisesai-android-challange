root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 140
# Test names are sentences in backticks (GIVEN ..., WHEN ..., THEN ...), so they may be long.
ktlint_ignore_back_ticked_identifier = true
# Composables are named like classes, and previews follow the same rule.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Trailing commas, as the code already uses.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{xml,md}]
max_line_length = off

# The package `view_model` is the project's naming (ARCHITECTURE.md section 3).
[*.kt]
ktlint_standard_package-name = disabled

# Instrumented tests use underscores, because DEX before version 40 forbids spaces (ARCHITECTURE.md section 9).
[**/androidTest/**.kt]
ktlint_standard_function-naming = disabled
